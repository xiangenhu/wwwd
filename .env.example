# ════════════════════════════════════════════════════
# WWWD backend · environment configuration
# ════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────
PORT=8000
CORS_ORIGINS=*

# ════════════════════════════════════════════════════
# LLM provider · pick ONE
# ════════════════════════════════════════════════════
# anthropic | openai | deepseek | zhipu | openai-compat
LLM_PROVIDER=anthropic

# Optional global override (otherwise the per-provider _MODEL var below wins)
# LLM_MODEL=

# ── Anthropic (default) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5
# ANTHROPIC_BASE_URL=

# ── OpenAI ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=                       # optional; SDK default if unset

# ── Deepseek (OpenAI-compatible) ────────────────────
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat            # or: deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Zhipu / GLM (OpenAI-compatible) ─────────────────
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4-plus                  # or: glm-4, glm-4-flash, glm-4-air
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Generic OpenAI-compatible (Moonshot, Qwen, vLLM, Ollama, …) ──
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_BASE_URL=                 # required for openai-compat

# ════════════════════════════════════════════════════
# Corpus source · WWWD_CORPUS_SOURCE
# ════════════════════════════════════════════════════
# local (default) | gcs
WWWD_CORPUS_SOURCE=local

# Local-disk paths (only used when WWWD_CORPUS_SOURCE=local)
WWWD_CORPUS_PATH=./data/corpus.json
WWWD_EMBEDDINGS_PATH=./data/embeddings.json

# GCS (only used when WWWD_CORPUS_SOURCE=gcs)
# Authenticates via Application Default Credentials:
#   gcloud auth application-default login   (local)
#   service-account on Cloud Run             (prod)
# WWWD_GCS_BUCKET=wwwd-corpus
# WWWD_CORPUS_VERSION=v1
# WWWD_CACHE_DIR=/tmp/wwwd-cache

# Embedding model (Hugging Face id, downloaded to .cache/transformers)
WWWD_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5

# ════════════════════════════════════════════════════
# xAPI LRS forwarding (optional)
# ════════════════════════════════════════════════════
# When unset, statements only go to stdout. When set, every emitted
# statement is also POSTed to {LRS_ENDPOINT}/statements with Basic Auth,
# fire-and-forget so the deliberation stream is never blocked.
# LRS_ENDPOINT=https://your-lrs.example/xapi
# LRS_BASIC_AUTH=                         # base64(user:pass)
# LRS_XAPI_VERSION=1.0.3
# LRS_TIMEOUT_MS=2000

# ════════════════════════════════════════════════════
# Auth (optional Google OAuth)
# ════════════════════════════════════════════════════
# Without GOOGLE_OAUTH_CLIENT_ID, all users are anonymous (X-Wwwd-Session).
GOOGLE_OAUTH_CLIENT_ID=
WWWD_REQUIRE_AUTH=0
WWWD_ACTOR_SALT=change-me-to-a-random-32-byte-hex
WWWD_ACTOR_HOMEPAGE=https://wwwd.skoonline.org
