# ════════════════════════════════════════════════════
# WWWD backend · environment configuration
# ════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────
PORT=8000

# NODE_ENV=production hardens defaults: refuses to start with '*' CORS,
# refuses placeholder salt, refuses unverified corpus, etc.
# NODE_ENV=development

# Comma-separated origins. In development the default is loopback only.
# In production this MUST be set explicitly — '*' is rejected unless
# WWWD_REQUIRE_AUTH=1 is also set.
# CORS_ORIGINS=https://wwwd.example.org

# Rate limits (per pseudonymous actor identity for deliberate/xapi,
# per IP for health). Tune up/down for your traffic profile.
# RATE_LIMIT_DELIBERATE=10    # per hour
# RATE_LIMIT_XAPI=60          # per minute
# RATE_LIMIT_HEALTH=30        # per minute
# TRUST_PROXY_HOPS=1          # if behind a single reverse proxy

# ════════════════════════════════════════════════════
# LLM provider · pick ONE
# ════════════════════════════════════════════════════
# anthropic | openai | azure | deepseek | zhipu | openai-compat
LLM_PROVIDER=anthropic

# Optional global override (otherwise the per-provider _MODEL var below wins)
# LLM_MODEL=

# ── Anthropic (default) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5
# ANTHROPIC_BASE_URL=

# ── OpenAI ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=                       # optional; SDK default if unset

# ── Azure OpenAI ────────────────────────────────────
# Models are addressed by deployment name on Azure.
# Endpoint is the resource root (no trailing /openai or /deployments).
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini    # the *deployment* name in your Azure resource
# AZURE_OPENAI_API_VERSION=2024-10-21    # optional; default 2024-10-21
# AZURE_OPENAI_MODEL=                    # optional override (otherwise deployment is used)

# ── Deepseek (OpenAI-compatible) ────────────────────
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat            # or: deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Zhipu / GLM (OpenAI-compatible) ─────────────────
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4-plus                  # or: glm-4, glm-4-flash, glm-4-air
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Generic OpenAI-compatible (Moonshot, Qwen, vLLM, Ollama, …) ──
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_BASE_URL=                 # required for openai-compat

# ════════════════════════════════════════════════════
# Corpus source · WWWD_CORPUS_SOURCE
# ════════════════════════════════════════════════════
# local (default) | gcs
WWWD_CORPUS_SOURCE=local

# Local-disk paths (only used when WWWD_CORPUS_SOURCE=local)
WWWD_CORPUS_PATH=./data/corpus.json
WWWD_EMBEDDINGS_PATH=./data/embeddings.json

# GCS (only used when WWWD_CORPUS_SOURCE=gcs)
# Auth resolution order:
#   1. WWWD_GCS_KEY_FILE (path to service-account JSON key)   ← simplest for local
#   2. GOOGLE_APPLICATION_CREDENTIALS                          ← standard ADC env var
#   3. gcloud auth application-default login                   ← local user creds
#   4. metadata server                                         ← Cloud Run / GCE
# WWWD_GCS_BUCKET=wwwd-corpus
# WWWD_CORPUS_VERSION=v1
# WWWD_GCS_KEY_FILE=./gcs-key.json
# WWWD_GCP_PROJECT=                       # optional override
# WWWD_CACHE_DIR=/tmp/wwwd-cache

# Embedding model (Hugging Face id, downloaded to .cache/transformers)
WWWD_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5

# ════════════════════════════════════════════════════
# xAPI LRS forwarding (optional)
# ════════════════════════════════════════════════════
# When unset, statements only go to stdout. When set, every emitted
# statement is also POSTed to {LRS_ENDPOINT}/statements with Basic Auth,
# fire-and-forget so the deliberation stream is never blocked.
# LRS_ENDPOINT=https://your-lrs.example/xapi
#
# Auth — pick ONE form:
#   (a) supply username + password and let the server base64-encode them
# LRS_AUTH_TYPE=basic
# LRS_USERNAME=
# LRS_PASSWORD=
#   (b) supply pre-encoded base64(user:pass) directly
# LRS_BASIC_AUTH=
#
# LRS_XAPI_VERSION=1.0.3
# LRS_TIMEOUT_MS=2000

# ════════════════════════════════════════════════════
# Auth (optional Google OAuth)
# ════════════════════════════════════════════════════
# Without GOOGLE_OAUTH_CLIENT_ID, all users are anonymous (X-Wwwd-Session).
GOOGLE_OAUTH_CLIENT_ID=
WWWD_REQUIRE_AUTH=0
WWWD_ACTOR_SALT=change-me-to-a-random-32-byte-hex
WWWD_ACTOR_HOMEPAGE=https://wwwd.skoonline.org
